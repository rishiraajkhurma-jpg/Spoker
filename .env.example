# Required
APP_PASSWORD=choose-a-long-password        # dashboard login
ANTHROPIC_API_KEY=                         # console.anthropic.com (default provider)
GEMINI_API_KEY=                            # optional alternative: aistudio.google.com/apikey
LLM_PROVIDER=                              # optional: gemini | anthropic
GEMINI_MODEL=gemini-3.8-flash              # optional
DATABASE_URL=                              # added automatically by the Vercel Neon integration
# Recommended
CRUSTDATA_API_KEY=                         # app.crustdata.com, used as Bearer token for the Crustdata MCP
SD_MODEL=                                  # optional model override
CRON_SECRET=                               # any random string; Vercel cron sends it as a Bearer token
# Gmail sending (Google Cloud OAuth client, type Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI to register in Google Cloud: https://<your-app>.vercel.app/api/google/callback
